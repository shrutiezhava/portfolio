generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id // Corresponds to Supabase Auth UID
  email     String   @unique
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String // Rich text content from TipTap
  excerpt       String?
  featuredImage String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
}


model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  content       String // Rich text
  techStack     String
  liveUrl       String?
  githubUrl     String?
  featuredImage String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  bio       String
  avatarUrl String?
  twitter   String?
  github    String?
  linkedin  String?
  updatedAt DateTime @updatedAt
}

